# Apify API Configuration for Scraping
# Get your API token from: https://console.apify.com/settings/integrations

# Single Token Mode
APIFY_TOKEN=your_apify_api_token_here

# Multi-Token Mode (comma-separated tokens for rotating scraper)
APIFY_TOKENS=apify_api_token_1,apify_api_token_2,apify_api_token_3
